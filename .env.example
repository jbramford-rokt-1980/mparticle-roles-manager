# mParticle Custom Roles Manager — local configuration
#
# Copy to .env and adjust if needed. Every value here is optional config.
# API credentials do NOT go in this file — they are entered in the app and
# stored encrypted in data/vault.enc.json.

# Port for the local proxy server (binds 127.0.0.1 only).
#ROLES_PROXY_PORT=8931

# Where the encrypted vault and history files are written.
# Defaults to <repo>/data (gitignored).
#DATA_DIR=./data

# Minutes of inactivity before the vault locks itself and credentials are
# dropped from memory. Set 0 to disable auto-lock.
#IDLE_LOCK_MINUTES=30

# Run against an in-memory fake mParticle API instead of the real one.
# Useful for trying the UI with zero credentials.
#MOCK_MPARTICLE=1
