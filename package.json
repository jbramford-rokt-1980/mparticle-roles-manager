{
  "name": "mparticle-roles-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:mock": "MOCK_MPARTICLE=1 npm run dev",
    "dev:guide": "node -e \"require('node:fs').rmSync('.guide-data',{recursive:true,force:true})\" && MOCK_MPARTICLE=1 DATA_DIR=./.guide-data ROLES_PROXY_PORT=8932 ROLES_UI_PORT=5174 npm run dev",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "guide": "node docs/generate-guide.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  }
}
